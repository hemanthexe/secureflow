    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/sensible": "^6.0.1",
    "@secureflow/policy": "workspace:*",
    "@secureflow/risk": "workspace:*",
    "@secureflow/scanners": "workspace:*",
    "@secureflow/shared": "workspace:*",
    "fastify": "^5.2.1",
    "prisma": "^6.1.0",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.28.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
